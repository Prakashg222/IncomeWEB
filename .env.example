FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
AADHAAR_LOOKUP_KEY=replace-with-an-independent-random-secret
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database?sslmode=require

# Bootstrap is performed once by `flask create-admin`.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-random-password-at-least-12-characters

# Set both percentages together; leave both unset until configured.
COMPANY_SHARE_PERCENT=
USER_SHARE_PERCENT=

# Required for persistent uploads on Vercel / production.
AWS_S3_BUCKET=
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret-key
AWS_S3_ENDPOINT_URL=
# Also accepts AWS_ENDPOINT_URL_S3.

# Gmail SMTP (use a Google App Password).
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
MAIL_FROM=

# Set a long random token for the scheduled monthly email endpoint.
CRON_SECRET=
