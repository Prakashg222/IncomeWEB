FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
AADHAAR_LOOKUP_KEY=replace-with-an-independent-random-secret
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/income_tracker

# Bootstrap is performed once by `flask create-admin`.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password

# Set both percentages together; leave both unset until configured.
COMPANY_SHARE_PERCENT=
USER_SHARE_PERCENT=

# Required for persistent uploads on Vercel / production.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=

# Gmail SMTP (use a Google App Password).
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
MAIL_FROM=

# Set a long random token for the scheduled monthly email endpoint.
CRON_SECRET=
