{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{app.py,templates/**,static/**,category_rates.json,auto_reader.py,services/**,models.py,extensions.py,config.py,routes.py}"
    }
  },
  "crons": [
    {
      "path": "/api/monthly-email",
      "schedule": "25 18 * * *"
    }
  ]
}